# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored — never commit real keys.
# ─────────────────────────────────────────────────────────────────────────

# Public origin of the site. Used to build the absolute return URL that
# KOMOJU redirects to after payment, so it MUST match the deployed domain.
# Locally, leave it as http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── KOMOJU (payments) ────────────────────────────────────────────────────
# Dashboard: https://komoju.com  →  Settings → API keys
#
# Test keys begin "sk_test_", live keys "sk_live_".
# Use the TEST key until you have completed a full test purchase.
#
# (Left empty on purpose: a realistic-looking dummy key here trips GitHub's
#  secret scanner, since KOMOJU keys share a prefix shape with Stripe's.)
KOMOJU_SECRET_KEY=

# Dashboard → Webhooks. Add the endpoint:
#     https://<your-domain>/api/webhooks/komoju
# then copy the signing secret here.
#
# Without this, the webhook endpoint rejects every request and orders will
# never be marked paid.
KOMOJU_WEBHOOK_SECRET=

# ── Instagram (live feed on the home page) ───────────────────────────────
# A long-lived Instagram User Access Token for @patisserielayers.
# Requires the account to be a Business or Creator account.
# See the setup steps in lib/instagram.ts.
#
# Leave blank to show the "view on Instagram" fallback card instead.
# ⚠️ Expires after 60 days — see refreshAccessToken() in lib/instagram.ts.
INSTAGRAM_ACCESS_TOKEN=
